# Navigate to the git root, then into ./client
TOP_LEVEL=$(git rev-parse --show-toplevel)
CLIENT_DIR="$TOP_LEVEL/client"
SERVER_DIR="$TOP_LEVEL/server"
VENV_DIR="$SERVER_DIR/.venv"

# # CLIENT
# cd "$CLIENT_DIR"
# npm run lint
# npm test

# # SERVER
cd "$SERVER_DIR"
if [ ! -d "$VENV_DIR" ]; then
  echo "Error: no .venv found at $VENV_DIR"
  echo "Create one with: python3 -m venv .venv (see README)"
  exit 1
fi

. "$VENV_DIR/bin/activate"
python -m pip install --upgrade pip
pip install -r requirements.txt
cd "$SERVER_DIR"
pwd
pylint --rcfile=pylintrc . --recursive=true --load-plugins pylint_django --django-settings-module=ttrpgPlanner.settings dungeonPlanner
deactivate
          