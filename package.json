{
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7"
  },
  "scripts": {
    "prepare": "husky",
    "commit": "cz",
    "commit:lint:prev": "git log -n 1 --format=%B | npx commitlint",
    "commit:lint:branch": "npx commitlint --from=$(git merge-base HEAD origin/main) --to=HEAD"
  },
  "license": "MIT",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
