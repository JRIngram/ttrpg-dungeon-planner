meta {
  name: Create Room
  type: http
  seq: 1
}

post {
  url: http://localhost:8000/dungeonPlanner/room
  body: json
  auth: inherit
}

body:json {
  {
    "dungeon": 1,
    "name": "Shrine to Dave",
    "description": "An unholy shrine to Dave",
    "monsters": [
      {
        "monster": 1, 
        "quantity": 104
      }],
    "traps": [   {
        "trap": 1, 
        "quantity": 104
      }]
  }
}

settings {
  encodeUrl: true
}
